{
  "manifest_version": 3,
  "name": "SocketLog++",
  "version": "0.0.1",
  "description": "SocketLog++",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "static/images/logo_16.png",
    "32": "static/images/logo_32.png",
    "64": "static/images/logo_64.png",
    "128": "static/images/logo_128.png",
    "320": "static/images/logo_320.png"
  },
  "action": {
    "default_icon": "static/images/logo_64.png",
    "default_popup": "popup.html",
    "default_title": "SocketLog++"
  },
  "background": {
    "service_worker": "background/index.js"
  },
  "content_scripts": [
    {
      "js": [
        "content/index.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "optional_host_permissions":[
  ],
  "web_accessible_resources": [
    {
      "resources": ["_auto_fill_"],
      "matches": ["<all_urls>"]
    }
  ]
}
