    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@eslint/js": "^9.3.0",
    "@samrum/vite-plugin-web-extension": "^5.0.0",
    "@types/chrome": "^0.0.268",
    "@types/lodash-es": "^4.17.12",
    "@types/webextension-polyfill": "^0.10.6",
    "@vitejs/plugin-vue": "^4.5.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.1",
    "eslint": "9.x",
    "eslint-plugin-vue": "^9.26.0",
    "filemanager-webpack-plugin": "^8.0.0",
    "globals": "^15.3.0",
    "html-webpack-plugin": "^5.6.0",
    "rollup": "^4.18.0",
    "style-loader": "^3.3.4",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^1.8.22",
    "web-ext": "^7.8.0",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "devel": "cross-env NODE_ENV=development webpack",
    "build_old": "cross-env NODE_ENV=production webpack",
    "analyz": "cross-env npm_config_report=true NODE_ENV=production webpack",
    "build": "vue-tsc --noEmit && vite build",
    "watch": "vite build --watch --mode development --minify false --sourcemap true",
    "dev": "vite",
    "serve:firefox": "web-ext run --start-url \"about:debugging#/runtime/this-firefox\"  --source-dir ./dist/",
    "serve:chrome": "web-ext run -t chromium --start-url \"https://example.com\" --source-dir ./dist/"
  },
  "browserslist": [
    "Chrome >= 116",
    "Edge >= 116",
    "Firefox >= 113",
    "not dead"
  ],
  "volta": {
    "node": "18.20.3"
  }
